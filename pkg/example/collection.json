{
  "info": {
    "_postman_id": "apitester-example-collection",
    "name": "API Tester Example Suite",
    "description": "Comprehensive test suite for API Tester featuring GET, POST, PUT, PATCH, DELETE, query params, path params, headers, bearer auth, no-auth, JSON bodies, and multipart form-data upload.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "id": "root-token-id",
        "key": "token",
        "value": "secret-bearer-token-123",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "id": "var-base-url",
      "key": "baseUrl",
      "category": "BASE_URL",
      "value": "https://apitester-frontend.vercel.app",
      "type": "string"
    },
    {
      "id": "var-token",
      "key": "token",
      "category": "AUTH",
      "value": "secret-bearer-token-123",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Items (CRUD & Params)",
      "item": [
        {
          "name": "Get Items (Query Params)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/items?category=electronics&search=mouse&limit=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "items"
              ],
              "query": [
                {
                  "id": "q1",
                  "key": "category",
                  "value": "electronics",
                  "type": "text",
                  "description": "Filter by category"
                },
                {
                  "id": "q2",
                  "key": "search",
                  "value": "mouse",
                  "type": "text",
                  "description": "Search term for name/category"
                },
                {
                  "id": "q3",
                  "key": "in_stock",
                  "value": "true",
                  "type": "text",
                  "description": "Filter by stock availability"
                },
                {
                  "id": "q4",
                  "key": "limit",
                  "value": "10",
                  "type": "text",
                  "description": "Max items per page"
                },
                {
                  "id": "q5",
                  "key": "page",
                  "value": "1",
                  "type": "text",
                  "description": "Page number"
                }
              ]
            },
            "description": "Retrieve items filtered by query parameters (category, search keyword, in_stock, pagination)."
          }
        },
        {
          "name": "Get Item by ID (Path Param & Headers)",
          "request": {
            "method": "GET",
            "header": [
              {
                "id": "h1",
                "key": "X-Request-ID",
                "value": "req-test-trace-001"
              },
              {
                "id": "h2",
                "key": "X-Client-Version",
                "value": "1.2.0"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/items/:id",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "items",
                ":id"
              ]
            },
            "description": "Fetch details for a specific item using a path parameter. Echoes back X-Request-ID."
          }
        },
        {
          "name": "Create Item (POST with JSON Body)",
          "request": {
            "method": "POST",
            "header": [
              {
                "id": "h-ct",
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Noise Cancelling Headphones\",\n  \"category\": \"electronics\",\n  \"price\": 199.99,\n  \"tags\": [\n    \"audio\",\n    \"bluetooth\",\n    \"hardware\"\n  ],\n  \"in_stock\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/items",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "items"
              ]
            },
            "description": "Create a new item by providing a JSON payload."
          }
        },
        {
          "name": "Update Item (PUT with Path Param & JSON Body)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "id": "h-ct",
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Wireless Ergonomic Mouse Pro\",\n  \"category\": \"electronics\",\n  \"price\": 39.99,\n  \"tags\": [\n    \"hardware\",\n    \"peripheral\",\n    \"wireless\"\n  ],\n  \"in_stock\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/items/:id",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "items",
                ":id"
              ]
            },
            "description": "Completely update an existing item by ID."
          }
        },
        {
          "name": "Partial Update Item (PATCH with Path Param & JSON Body)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "id": "h-ct",
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 24.99,\n  \"in_stock\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/items/:id",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "items",
                ":id"
              ]
            },
            "description": "Partially update selected fields of an item."
          }
        },
        {
          "name": "Delete Item (DELETE with Path Param)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/items/:id",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "items",
                ":id"
              ]
            },
            "description": "Delete an item by ID."
          }
        }
      ]
    },
    {
      "name": "Auth (Secure Endpoints)",
      "item": [
        {
          "name": "Get Profile (With Bearer Auth)",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "id": "b1",
                  "key": "token",
                  "value": "secret-bearer-token-123",
                  "type": "string"
                }
              ],
              "authSource": "onrequest"
            },
            "header": [
              {
                "id": "h-auth",
                "key": "Authorization",
                "value": "Bearer secret-bearer-token-123"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/secure/profile",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "secure",
                "profile"
              ]
            },
            "description": "Access protected user profile using a Bearer token."
          }
        },
        {
          "name": "Get Profile (Without Auth - 401 Expected)",
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/secure/profile",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "secure",
                "profile"
              ]
            },
            "description": "Attempt to access protected endpoint without Authorization header to verify 401 Unauthorized."
          }
        },
        {
          "name": "Secure Action (With Bearer Auth & JSON Body)",
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "id": "b2",
                  "key": "token",
                  "value": "secret-bearer-token-123",
                  "type": "string"
                }
              ],
              "authSource": "onrequest"
            },
            "header": [
              {
                "id": "h-auth",
                "key": "Authorization",
                "value": "Bearer secret-bearer-token-123"
              },
              {
                "id": "h-ct",
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"restart_cluster\",\n  \"environment\": \"staging\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/secure/action",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "secure",
                "action"
              ]
            },
            "description": "Execute an authorized administrative action with JSON payload."
          }
        }
      ]
    },
    {
      "name": "Upload (Multipart Form Data)",
      "item": [
        {
          "name": "Upload File & Form Data",
          "request": {
            "method": "POST",
            "header": [
              {
                "id": "h-mp",
                "key": "Content-Type",
                "value": "multipart/form-data"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "id": "f1",
                  "key": "title",
                  "value": "Release Notes Q4",
                  "type": "text"
                },
                {
                  "id": "f2",
                  "key": "description",
                  "value": "Comprehensive changelog and migration guide",
                  "type": "text"
                },
                {
                  "id": "f3",
                  "key": "file",
                  "value": "",
                  "type": "file"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/upload",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "upload"
              ]
            },
            "description": "Upload files and key-value metadata using multipart/form-data."
          }
        }
      ]
    },
    {
      "name": "Diagnostics & Headers",
      "item": [
        {
          "name": "Echo Request Headers",
          "request": {
            "method": "GET",
            "header": [
              {
                "id": "h-c1",
                "key": "X-Custom-Header",
                "value": "Testing-Apitester-Custom-Header"
              },
              {
                "id": "h-c2",
                "key": "X-Request-ID",
                "value": "req-trace-echo-999"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/headers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "headers"
              ]
            },
            "description": "Inspect all HTTP headers received by the backend service."
          }
        },
        {
          "name": "Health Check (Public)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Simple health check returning service status."
          }
        },
        {
          "name": "Get Users (Public)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users"
              ]
            },
            "description": "Sample users listing endpoint."
          }
        }
      ]
    }
  ]
}